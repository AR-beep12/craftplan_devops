<!DOCTYPE html>
<html lang="es" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix={
      if assigns[:page_title] in [nil, "", "Craftplan"], do: "", else: " · Craftplan"
    }>
      {assigns[:page_title] || "Craftplan"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23ec4899'/><text x='16' y='23' text-anchor='middle' font-family='sans-serif' font-weight='700' font-size='22' fill='white'>H</text></svg>" />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  </head>
  <body class="craftplan-web bg-stone-50 text-stone-800">
    {@inner_content}
  </body>
</html>
